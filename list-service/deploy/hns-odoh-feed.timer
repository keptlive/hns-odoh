# Refresh the ODoH feed a few times a day. The DNSCrypt lists change rarely
# (new relays are the interesting event), so this is deliberately unhurried;
# the browser caches the feed and a missed run just serves the last good one.
[Unit]
Description=Periodic ODoH feed refresh

[Timer]
OnBootSec=5min
OnUnitActiveSec=6h
RandomizedDelaySec=20min
Persistent=true

[Install]
WantedBy=timers.target
