# 32 bytes of hex; the ODoH key pair is derived from this seed, so keep it
# stable (clients cache the derived config for an hour) and keep it secret.
SEED_SECRET_KEY=<openssl rand -hex 32>
PORT=8054
# Comma-separated upstream resolvers. Point at a HANDSHAKE-AWARE recursive
# (hsd's, 127.0.0.1:5350 in the reference deployment) or this target cannot
# resolve Handshake names.
ODOH_NAMESERVERS=127.0.0.1:5350
TARGET_INSTANCE_NAME=odoh.example.com
